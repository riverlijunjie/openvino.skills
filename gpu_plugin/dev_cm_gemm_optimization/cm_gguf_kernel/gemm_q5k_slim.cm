/*
 * gemm_q5k_slim.cm — Dense Q5_K GEMM, unified layout (v3).
 *
 * UNIFIED: fp16 inputs, SG-transposed weights (same as gemv_q5k_sg.cm),
 * scalar dot-product accumulation (SYCL Q5K slim is also scalar).
 *
 * Converted from sycl_gguf_kernel/gemm_q5k_L1_slim.xve.cpp.
 *
 * == Weight layout == (IDENTICAL to gemv_q5k_sg.cm)
 *   pqs_T: num_blocks * OPG * 128 bytes
 *   pqh_T: num_blocks * OPG * 32 bytes
 *   psl_T: num_blocks * OPG * 16 bytes
 *   weights = pqs_T || pqh_T || psl_T
 *   (Prepare with pack_qk_pqs_sg, pack_q5k_pqh_sg, pack_qk_psl_sg from test_dense_gemv.py)
 *
 * == Input == fp16 [token_len * input_len]
 *
 * == Dispatch ==
 *   global (threads) = (output_len/OPG * nbpr, token_len)   2D
 *   local  (threads)  = (nbpr, 1)
 */

#include <cm/cm.h>

#define OPG 16
#define MAX_NBPR 64
#define W2_MASK  0x000F000Fu
#define QH_MASK  0x00100010u

_GENX_ inline vector<float, OPG> q5k_subblock(
        vector<uint, OPG> q0, vector<uint, OPG> q1,
        vector<uint, OPG> q2, vector<uint, OPG> q3,
        vector<uint, OPG> H, vector<float, 32> in32)
{
    vector<float, OPG> acc = 0.0f;
    vector<uint, OPG> a, b, c, d;
    vector<float, OPG> wl0, wl1, wl2, wl3, wh0, wh1, wh2, wh3;

    a=(q0&W2_MASK)|((H<<4)&QH_MASK); b=((q0>>8)&W2_MASK)|((H>>4)&QH_MASK);
    c=((q0>>4)&W2_MASK)|((H>>0)&QH_MASK); d=((q0>>12)&W2_MASK)|((H>>8)&QH_MASK);
    wl0=(a&0xFFFFu);wl1=(b&0xFFFFu);wl2=(a>>16);wl3=(b>>16);
    wh0=(c&0xFFFFu);wh1=(d&0xFFFFu);wh2=(c>>16);wh3=(d>>16);
    acc+=wl0*in32[0]+wl1*in32[1]+wl2*in32[2]+wl3*in32[3];
    acc+=wh0*in32[16]+wh1*in32[17]+wh2*in32[18]+wh3*in32[19];

    a=(q1&W2_MASK)|((H<<3)&QH_MASK); b=((q1>>8)&W2_MASK)|((H>>5)&QH_MASK);
    c=((q1>>4)&W2_MASK)|((H>>1)&QH_MASK); d=((q1>>12)&W2_MASK)|((H>>9)&QH_MASK);
    wl0=(a&0xFFFFu);wl1=(b&0xFFFFu);wl2=(a>>16);wl3=(b>>16);
    wh0=(c&0xFFFFu);wh1=(d&0xFFFFu);wh2=(c>>16);wh3=(d>>16);
    acc+=wl0*in32[4]+wl1*in32[5]+wl2*in32[6]+wl3*in32[7];
    acc+=wh0*in32[20]+wh1*in32[21]+wh2*in32[22]+wh3*in32[23];

    a=(q2&W2_MASK)|((H<<2)&QH_MASK); b=((q2>>8)&W2_MASK)|((H>>6)&QH_MASK);
    c=((q2>>4)&W2_MASK)|((H>>2)&QH_MASK); d=((q2>>12)&W2_MASK)|((H>>10)&QH_MASK);
    wl0=(a&0xFFFFu);wl1=(b&0xFFFFu);wl2=(a>>16);wl3=(b>>16);
    wh0=(c&0xFFFFu);wh1=(d&0xFFFFu);wh2=(c>>16);wh3=(d>>16);
    acc+=wl0*in32[8]+wl1*in32[9]+wl2*in32[10]+wl3*in32[11];
    acc+=wh0*in32[24]+wh1*in32[25]+wh2*in32[26]+wh3*in32[27];

    a=(q3&W2_MASK)|((H<<1)&QH_MASK); b=((q3>>8)&W2_MASK)|((H>>7)&QH_MASK);
    c=((q3>>4)&W2_MASK)|((H>>3)&QH_MASK); d=((q3>>12)&W2_MASK)|((H>>11)&QH_MASK);
    wl0=(a&0xFFFFu);wl1=(b&0xFFFFu);wl2=(a>>16);wl3=(b>>16);
    wh0=(c&0xFFFFu);wh1=(d&0xFFFFu);wh2=(c>>16);wh3=(d>>16);
    acc+=wl0*in32[12]+wl1*in32[13]+wl2*in32[14]+wl3*in32[15];
    acc+=wh0*in32[28]+wh1*in32[29]+wh2*in32[30]+wh3*in32[31];

    return acc;
}

extern "C" _GENX_MAIN_ void gemm_q5k_slim(
    half*  inputs  [[type("svmptr_t")]],
    uchar* weights [[type("svmptr_t")]],   /* pqs_T || pqh_T || psl_T */
    float* outputs [[type("svmptr_t")]],
    uint token_len,
    uint input_len,
    uint output_len)
{
    const uint nbpr       = input_len / 256;
    const uint num_blocks = input_len * output_len / 256;

    cm_slm_init(MAX_NBPR * OPG * sizeof(float));
    uint slm = cm_slm_alloc(MAX_NBPR * OPG * sizeof(float));

    const uint h  = cm_group_id(0);
    const uint hh = cm_local_id(0);
    const uint t  = cm_group_id(1);

    uchar* pqs_base = weights;
    uchar* pqh_base = weights + num_blocks * 128u;
    uchar* psl_base = weights + num_blocks * 160u;

    const uint blk      = h * nbpr + hh;
    const uint pe_byte  = blk * (OPG * 128u);
    const uint pqh_byte = blk * (OPG * 32u);
    const uint psl_byte = blk * (OPG * 16u);
    const uint in_byte  = t * input_len * (uint)sizeof(half) + hh * 256u * (uint)sizeof(half);

    vector<uint, OPG>   sl    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 0);
    vector<uint, OPG>   ml    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 64);
    vector<uint, OPG/2> sh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 128);
    vector<uint, OPG/2> mh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 160);
    vector<uint, OPG/2> d_u   = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 192);
    vector<uint, OPG/2> dmn_u = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 224);
    vector<ushort, OPG> sh16 = sh_u.format<ushort>();
    vector<ushort, OPG> mh16 = mh_u.format<ushort>();
    vector<half, OPG>   dh   = d_u.format<half>();
    vector<half, OPG>   dminh= dmn_u.format<half>();
    vector<uint, OPG> shu = sh16, mhu = mh16;
    vector<float, OPG> dF, dminF;
    dF = dh; dminF = dminh;

    vector<float, OPG> acc = 0.0f;

    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, OPG> sq = ((sl >> (j * 4)) & 0xFu) | (((shu >> (j * 2)) & 0x3u) << 4);
        vector<uint, OPG> mq = ((ml >> (j * 4)) & 0xFu) | (((mhu >> (j * 2)) & 0x3u) << 4);
        vector<float, OPG> sqf, mqf; sqf = sq; mqf = mq;
        vector<float, OPG> scale_j = sqf * dF;
        vector<float, OPG> minv_j  = mqf * dminF;

        vector<uint, OPG> q0 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte  + j*256 + 0*64);
        vector<uint, OPG> q1 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte  + j*256 + 1*64);
        vector<uint, OPG> q2 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte  + j*256 + 2*64);
        vector<uint, OPG> q3 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte  + j*256 + 3*64);
        vector<uint, OPG> H  = cm_ptr_load<uint, OPG>((uint*)pqh_base, pqh_byte + j * 64);

        vector<uint, 16>  in_u32 = cm_ptr_load<uint, 16>((uint*)inputs, in_byte + j * 64);
        vector<half, 32>  in32h  = in_u32.format<half>();
        vector<float, 32> in32   = in32h;
        float isum_j = cm_sum<float>(in32);

        vector<float, OPG> sub = q5k_subblock(q0, q1, q2, q3, H, in32);
        acc += scale_j * sub - minv_j * isum_j;
    }

    cm_slm_block_write(slm, hh * OPG * sizeof(float), acc.format<float>());
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();

    if (hh == 0) {
        vector<float, OPG> total = 0.0f;
        for (uint k = 0; k < nbpr; k++) {
            vector<float, OPG> part;
            cm_slm_block_read(slm, GENX_NONE, k * OPG * sizeof(float), part.format<float>());
            total += part;
        }
        cm_ptr_store<float, OPG>((float*)outputs, (t * output_len + h * OPG) * (uint)sizeof(float), total);
    }
}


#include <cm/cm.h>

#define OPG 16
#define MAX_NBPR 64

_GENX_ inline void decode_q5k_scales(uchar* psl, uint sl_off, float* scale, float* minv)
{
    vector<uint, 2>  slml = cm_ptr_load<uint, 2>((uint*)psl, sl_off);
    vector<uint, 2>  shmh_u = cm_ptr_load<uint, 2>((uint*)psl, sl_off + 8);
    vector<ushort, 4> shmh = shmh_u.format<ushort>();
    uint sl = slml[0];
    uint ml = slml[1];
    uint sh = shmh[0];
    uint mh = shmh[1];
    vector<half, 2> dd = shmh.select<2, 1>(2).format<half>();
    float d    = dd[0];
    float dmin = dd[1];

    #pragma unroll
    for (int i = 0; i < 8; i++) {
        uint sq = ((sl >> (i * 4)) & 0xFu) | (((sh >> (i * 2)) & 0x3u) << 4);
        uint mq = ((ml >> (i * 4)) & 0xFu) | (((mh >> (i * 2)) & 0x3u) << 4);
        scale[i] = (float)sq * d;
        minv[i]  = (float)mq * dmin;
    }
}

/* One Q5_K sub-block (32 weights) dot product for a single output row.
 * bit-position table (same as the SYCL/OpenCL high_value_mask constant):
 *   lo-half weight k (0..15) 5th bit is at bit S[k] of the 32-bit qh word;
 *   hi-half weight (16+k) 5th bit is at bit S[k]+4. */
_GENX_ inline float q5k_block_dot(uchar* qs_ptr, uchar* qh_ptr,
                                   float* scale, float* minv, vector<float, 32> in_j[8])
{
    vector<uint, 16> S;
    S[0]=0;  S[1]=8;  S[2]=16; S[3]=24;
    S[4]=1;  S[5]=9;  S[6]=17; S[7]=25;
    S[8]=2;  S[9]=10; S[10]=18; S[11]=26;
    S[12]=3; S[13]=11; S[14]=19; S[15]=27;

    float acc = 0.0f;
    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, 4>  qb_u = cm_ptr_load<uint, 4>((uint*)qs_ptr, j * 16);
        vector<uchar, 16> qb = qb_u.format<uchar>();
        uint H = cm_ptr_load<uint, 1>((uint*)qh_ptr, j * 4)[0];
        vector<uint, 16> Hv = H;

        vector<uint, 16> bit_lo = (Hv >> S) & 1u;
        vector<uint, 16> bit_hi = (Hv >> (S + 4)) & 1u;
        vector<float, 16> bit_lo_f, bit_hi_f;
        bit_lo_f = bit_lo; bit_hi_f = bit_hi;

        vector<float, 16> wlo, whi;
        wlo = (qb & 0x0f); wlo += bit_lo_f * 16.0f;
        whi = ((qb >> 4) & 0x0f); whi += bit_hi_f * 16.0f;

        vector<float, 16> in_lo = in_j[j].select<16, 1>(0);
        vector<float, 16> in_hi = in_j[j].select<16, 1>(16);
        float dot_lo = cm_sum<float>(wlo * in_lo);
        float dot_hi = cm_sum<float>(whi * in_hi);
        float isum_lo = cm_sum<float>(in_lo);
        float isum_hi = cm_sum<float>(in_hi);
        acc += scale[j] * (dot_lo + dot_hi) - minv[j] * (isum_lo + isum_hi);
    }
    return acc;
}
