/*
 * moe_gemv_q4k_sg.cm — MoE Q4_K GEMV (CM / C-for-Metal port).
 *
 * Converted from sycl_gguf_kernel/gemv_q4k_L1.xve.cpp
 * (runGroupUpAndGateVecQ4KL1_xve_impl / runDownMergeQ4KL1_xve_impl), using the
 * same "SG-transposed" per-expert weight layout as the reference OpenCL port
 * (/mnt/river/ovmx/ocl_gguf_kernel/moe_gemv_q4k_sg.cl) and the same
 * dequantisation core as gemv_q4k_sg.cm. Each CM thread computes all OPG=16
 * output rows of a row-group directly via vector<float,OPG> SIMD arithmetic
 * (no sub-group lanes needed, unlike the OpenCL port). For simplicity /
 * correctness this port always reduces both up and gate matrices per thread
 * (the OpenCL SPLIT_UG register-saving optimisation is not replicated).
 *
 * == Per-expert weight layout (SG-transposed, identical to gemv_q4k_sg.cm) ==
 *   expert_size = num_blocks * 144  (pqs_T: num_blocks*128B || psl_T: num_blocks*16B)
 *
 * == Dispatch ==
 *   group_up_gate_q4k_sg:
 *     global (threads) = (output_len/OPG, KSPLIT, output_num*token_len)
 *     local  (threads)  = (1, KSPLIT, 1)
 *   down_merge_q4k_sg:
 *     global (threads) = (output_len/OPG, KSPLIT, token_len)
 *     local  (threads)  = (1, KSPLIT, 1)
 */

#include <cm/cm.h>

#define OPG 16

#ifndef KSPLIT
#define KSPLIT 1
#endif

#define W2_MASK 0x000F000Fu

/* Dequantise+accumulate one Q4_K sub-block (32 weights, 16 output rows at once). */
_GENX_ inline vector<float, OPG> q4k_subblock(
        vector<uint, OPG> q0, vector<uint, OPG> q1,
        vector<uint, OPG> q2, vector<uint, OPG> q3,
        vector<float, 32> in32)
{
    vector<float, OPG> acc = 0.0f;
    vector<uint, OPG> a, b, c, d;
    vector<float, OPG> wl0, wl1, wl2, wl3, wh0, wh1, wh2, wh3;

    a = q0 & W2_MASK; b = (q0 >> 8) & W2_MASK; c = (q0 >> 4) & W2_MASK; d = (q0 >> 12) & W2_MASK;
    wl0 = (a & 0xFFFFu); wl1 = (b & 0xFFFFu); wl2 = (a >> 16); wl3 = (b >> 16);
    wh0 = (c & 0xFFFFu); wh1 = (d & 0xFFFFu); wh2 = (c >> 16); wh3 = (d >> 16);
    acc += wl0 * in32[0] + wl1 * in32[1] + wl2 * in32[2]  + wl3 * in32[3];
    acc += wh0 * in32[16] + wh1 * in32[17] + wh2 * in32[18] + wh3 * in32[19];

    a = q1 & W2_MASK; b = (q1 >> 8) & W2_MASK; c = (q1 >> 4) & W2_MASK; d = (q1 >> 12) & W2_MASK;
    wl0 = (a & 0xFFFFu); wl1 = (b & 0xFFFFu); wl2 = (a >> 16); wl3 = (b >> 16);
    wh0 = (c & 0xFFFFu); wh1 = (d & 0xFFFFu); wh2 = (c >> 16); wh3 = (d >> 16);
    acc += wl0 * in32[4] + wl1 * in32[5] + wl2 * in32[6]  + wl3 * in32[7];
    acc += wh0 * in32[20] + wh1 * in32[21] + wh2 * in32[22] + wh3 * in32[23];

    a = q2 & W2_MASK; b = (q2 >> 8) & W2_MASK; c = (q2 >> 4) & W2_MASK; d = (q2 >> 12) & W2_MASK;
    wl0 = (a & 0xFFFFu); wl1 = (b & 0xFFFFu); wl2 = (a >> 16); wl3 = (b >> 16);
    wh0 = (c & 0xFFFFu); wh1 = (d & 0xFFFFu); wh2 = (c >> 16); wh3 = (d >> 16);
    acc += wl0 * in32[8] + wl1 * in32[9] + wl2 * in32[10] + wl3 * in32[11];
    acc += wh0 * in32[24] + wh1 * in32[25] + wh2 * in32[26] + wh3 * in32[27];

    a = q3 & W2_MASK; b = (q3 >> 8) & W2_MASK; c = (q3 >> 4) & W2_MASK; d = (q3 >> 12) & W2_MASK;
    wl0 = (a & 0xFFFFu); wl1 = (b & 0xFFFFu); wl2 = (a >> 16); wl3 = (b >> 16);
    wh0 = (c & 0xFFFFu); wh1 = (d & 0xFFFFu); wh2 = (c >> 16); wh3 = (d >> 16);
    acc += wl0 * in32[12] + wl1 * in32[13] + wl2 * in32[14] + wl3 * in32[15];
    acc += wh0 * in32[28] + wh1 * in32[29] + wh2 * in32[30] + wh3 * in32[31];

    return acc;
}

/* Decode the 8 per-sub-block (scale, min) pairs for a Q4_K block, all 16
 * output rows at once, from the psl_T SoA record at byte offset psl_byte. */
_GENX_ inline void q4k_decode_block(uchar* psl_base, uint psl_byte,
                                     vector<float, OPG>* scale8, vector<float, OPG>* minv8)
{
    vector<uint, OPG>   sl    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 0);
    vector<uint, OPG>   ml    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 64);
    vector<uint, OPG/2> sh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 128);
    vector<uint, OPG/2> mh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 160);
    vector<uint, OPG/2> d_u   = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 192);
    vector<uint, OPG/2> dmn_u = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 224);

    vector<ushort, OPG> sh16  = sh_u.format<ushort>();
    vector<ushort, OPG> mh16  = mh_u.format<ushort>();
    vector<half, OPG>   dh    = d_u.format<half>();
    vector<half, OPG>   dminh = dmn_u.format<half>();

    vector<uint, OPG> shu = sh16;
    vector<uint, OPG> mhu = mh16;
    vector<float, OPG> dF, dminF;
    dF = dh; dminF = dminh;

    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, OPG> sq = ((sl >> (j * 4)) & 0xFu) | (((shu >> (j * 2)) & 0x3u) << 4);
        vector<uint, OPG> mq = ((ml >> (j * 4)) & 0xFu) | (((mhu >> (j * 2)) & 0x3u) << 4);
        vector<float, OPG> sqf, mqf;
        sqf = sq; mqf = mq;
        scale8[j] = sqf * dF;
        minv8[j]  = mqf * dminF;
    }
}

/* Full Q4_K block dot product (all 8 sub-blocks), 16 output rows at once. */
_GENX_ inline vector<float, OPG> q4k_block_acc(uchar* pqs_base, uint pe_byte,
        vector<float, OPG>* scale8, vector<float, OPG>* minv8,
        vector<float, 32> in_j[8])
{
    vector<float, OPG> acc = 0.0f;
    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, OPG> q0 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte + j * 256 + 0 * 64);
        vector<uint, OPG> q1 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte + j * 256 + 1 * 64);
        vector<uint, OPG> q2 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte + j * 256 + 2 * 64);
        vector<uint, OPG> q3 = cm_ptr_load<uint, OPG>((uint*)pqs_base, pe_byte + j * 256 + 3 * 64);
        float isum_j = cm_sum<float>(in_j[j]);
        vector<float, OPG> sub = q4k_subblock(q0, q1, q2, q3, in_j[j]);
        acc += scale8[j] * sub - minv8[j] * isum_j;
    }
    return acc;
}

/* Load the 256 shared fp16 activations for one K-block as 8 fp32 sub-block
 * vectors (in_j[0..7], 32 elements each). */
_GENX_ inline void load_inputs(half* inputs, uint in_byte, vector<float, 32> in_j[8])
{
    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, 16>  u32  = cm_ptr_load<uint, 16>((uint*)inputs, in_byte + j * 64);
        vector<half, 32>  h32  = u32.format<half>();
        in_j[j] = h32;
    }
}

/* =======================================================================
 * Kernel 1: group_up_gate_q4k_sg
 * ===================================================================== */
extern "C" _GENX_MAIN_ void group_up_gate_q4k_sg(
    half*  inputs  [[type("svmptr_t")]],   /* [token_len * input_len]           */
    uchar* ups     [[type("svmptr_t")]],   /* [num_experts * expert_size]       */
    uchar* gates   [[type("svmptr_t")]],   /* [num_experts * expert_size]       */
    uint*  indexes [[type("svmptr_t")]],   /* [token_len*aligned_output_num] or 0 */
    float* outputs [[type("svmptr_t")]],   /* [token_len*output_num*output_len] */
    uint output_num,
    uint aligned_output_num,
    uint token_len,
    uint input_len,
    uint output_len)
{
    const uint nbpr        = input_len / 256;
    const uint num_blocks  = input_len * output_len / 256;
    const uint expert_size = num_blocks * 144;

    const uint h  = cm_group_id(0);
    const uint sg = cm_local_id(1);
    const uint vt = cm_group_id(2);
    const uint v  = vt % output_num;
    const uint t  = vt / output_num;

    const uint index = indexes ? indexes[t * aligned_output_num + v] : v;
    uchar* up_pqs = ups   + index * expert_size;
    uchar* gt_pqs = gates + index * expert_size;

#if KSPLIT > 1
    cm_slm_init(2 * KSPLIT * OPG * sizeof(float));
    uint slm = cm_slm_alloc(2 * KSPLIT * OPG * sizeof(float));
#endif

    vector<float, OPG> up_acc = 0.0f, gate_acc = 0.0f;
    const uint in_row_byte = t * input_len * (uint)sizeof(half);

    for (uint bid = sg; bid < nbpr; bid += KSPLIT) {
        const uint blk      = h * nbpr + bid;
        const uint pe_byte  = blk * (OPG * 128u);
        const uint psl_byte = blk * (OPG * 16u);
        const uint in_byte  = in_row_byte + bid * 256u * (uint)sizeof(half);

        vector<float, 32> in_j[8];
        load_inputs(inputs, in_byte, in_j);

        vector<float, OPG> u_scale[8], u_minv[8];
        q4k_decode_block(up_pqs + num_blocks * 128u, psl_byte, u_scale, u_minv);
        up_acc += q4k_block_acc(up_pqs, pe_byte, u_scale, u_minv, in_j);

        vector<float, OPG> g_scale[8], g_minv[8];
        q4k_decode_block(gt_pqs + num_blocks * 128u, psl_byte, g_scale, g_minv);
        gate_acc += q4k_block_acc(gt_pqs, pe_byte, g_scale, g_minv, in_j);
    }

    vector<float, OPG> u_total = up_acc, g_total = gate_acc;
#if KSPLIT > 1
    cm_slm_block_write(slm, (sg * 2 + 0) * OPG * sizeof(float), up_acc.format<float>());
    cm_slm_block_write(slm, (sg * 2 + 1) * OPG * sizeof(float), gate_acc.format<float>());
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();
    if (sg == 0) {
        u_total = 0.0f; g_total = 0.0f;
        #pragma unroll
        for (int r = 0; r < KSPLIT; r++) {
            vector<float, OPG> pu, pg;
            cm_slm_block_read(slm, GENX_NONE, (r * 2 + 0) * OPG * sizeof(float), pu.format<float>());
            cm_slm_block_read(slm, GENX_NONE, (r * 2 + 1) * OPG * sizeof(float), pg.format<float>());
            u_total += pu; g_total += pg;
        }
#endif
        vector<float, OPG> sig = 1.0f / (1.0f + cm_exp(-g_total * 1.4426950408889634f));
        vector<float, OPG> result = (sig * g_total) * u_total;
        cm_ptr_store<float, OPG>((float*)outputs,
                ((t * output_num + v) * output_len + h * OPG) * (uint)sizeof(float), result);
#if KSPLIT > 1
    }
#endif
}

/* =======================================================================
 * Kernel 2: down_merge_q4k_sg
 * ===================================================================== */
extern "C" _GENX_MAIN_ void down_merge_q4k_sg(
    half*  inputs     [[type("svmptr_t")]],  /* [token_len*input_num*input_len] */
    uchar* downs      [[type("svmptr_t")]],  /* [num_experts * expert_size]     */
    uint*  indexes    [[type("svmptr_t")]],  /* [token_len*aligned_input_num] or 0 */
    float* efficients [[type("svmptr_t")]],  /* [token_len*aligned_input_num]   */
    float* outputs    [[type("svmptr_t")]],  /* [token_len*output_len]          */
    uint input_num,
    uint aligned_input_num,
    uint token_len,
    uint input_len,
    uint output_len,
    int  is_acc)
{
    const uint nbpr        = input_len / 256;
    const uint num_blocks  = input_len * output_len / 256;
    const uint expert_size = num_blocks * 144;

    const uint h  = cm_group_id(0);
    const uint sg = cm_local_id(1);
    const uint t  = cm_group_id(2);

#if KSPLIT > 1
    cm_slm_init(KSPLIT * OPG * sizeof(float));
    uint slm = cm_slm_alloc(KSPLIT * OPG * sizeof(float));
#endif

    const uint total_iters = input_num * nbpr;
    vector<float, OPG> acc = 0.0f;

    for (uint idx = sg; idx < total_iters; idx += KSPLIT) {
        const uint e   = idx / nbpr;
        const uint bid = idx - e * nbpr;

        const uint index     = indexes ? indexes[t * aligned_input_num + e] : e;
        const float efficient = efficients[t * aligned_input_num + e];

        uchar* d_pqs = downs + index * expert_size;
        const uint blk      = h * nbpr + bid;
        const uint pe_byte  = blk * (OPG * 128u);
        const uint psl_byte = blk * (OPG * 16u);
        const uint in_byte  = (t * input_num * input_len + e * input_len + bid * 256u) * (uint)sizeof(half);

        vector<float, 32> in_j[8];
        load_inputs(inputs, in_byte, in_j);

        vector<float, OPG> scale8[8], minv8[8];
        q4k_decode_block(d_pqs + num_blocks * 128u, psl_byte, scale8, minv8);
        vector<float, OPG> blk_acc = q4k_block_acc(d_pqs, pe_byte, scale8, minv8, in_j);
        acc += blk_acc * efficient;
    }

#if KSPLIT == 1
    vector<float, OPG> total_out = acc;
#else
    cm_slm_block_write(slm, sg * OPG * sizeof(float), acc.format<float>());
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();
    if (sg == 0) {
        vector<float, OPG> total_out = 0.0f;
        #pragma unroll
        for (int r = 0; r < KSPLIT; r++) {
            vector<float, OPG> part;
            cm_slm_block_read(slm, GENX_NONE, r * OPG * sizeof(float), part.format<float>());
            total_out += part;
        }
#endif
        const uint out_byte = (t * output_len + h * OPG) * (uint)sizeof(float);
        if (is_acc) {
            vector<float, OPG> prev = cm_ptr_load<float, OPG>((float*)outputs, out_byte);
            total_out += prev;
        }
        cm_ptr_store<float, OPG>((float*)outputs, out_byte, total_out);
#if KSPLIT > 1
    }
#endif
}
