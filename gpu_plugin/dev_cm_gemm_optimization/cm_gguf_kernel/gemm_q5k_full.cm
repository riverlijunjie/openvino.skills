/*
 * gemm_q5k_full.cm -- Dense Q5_K GEMM, unified layout (v4).
 * fp16 inputs, SG-transposed weights (pqs_T||pqh_T||psl_T), cm_dpas.
 *
 * PERF (v4): dequant, not the dpas it feeds, limits this kernel; all 4
 * chunks of a sub-block are now decoded in one SIMD64 pass instead of 4
 * SIMD16 passes (~4x fewer dequant instructions, identical arithmetic).
 * Measured 1.20-1.31x faster on Arc B580. See gemm_q4k_full.cm's header
 * for the full list of alternatives that were measured and rejected.
 *
 * Dispatch: global=(N/OPG*nbpr, ceil(token_len/8)), local=(nbpr,1)
 */

#include <cm/cm.h>
#include <cm/cmtl.h>
#pragma OPENCL EXTENSION cl_khr_fp16 : enable

#define OPG 16
#define MAX_NBPR 64
#define TOKENS_PER_TILE 8
#define W2_MASK  0x000F000Fu
#define QH_MASK  0x00100010u

/* Build VNNI for Q5K: same nibble extraction as Q4K plus 5th bit from H.
 * 5th-bit shift for lo K-pos (4c+k3): 2c + 8*k3.  Same for hi (use H from same word). */
/* Decode all 4 chunks of sub-block j in ONE pass.
 * See gemm_q4k_full.cm's q4k_vnni_block_sg for the full rationale: pqs_T
 * stores chunk c at +c*64 bytes, so 64 consecutive uints are
 * [c=0..3][n=0..15] and the same 8 bit-field extractions run at SIMD64
 * instead of 4x SIMD16 -- 4x fewer dequant instructions, identical math.
 * The Q5_K 5th bit needs a per-c shift (shift = base + c), which is just a
 * per-element vector shift amount here. Destination is the strided 2D
 * region .select<4,2,16,2>(kpair, kbit) of the VNNI tile. */
_GENX_ inline void q5k_vnni_block_sg(
    uchar* pqs_base, uint pe_byte, int j, vector<uint, OPG> H,
    vector<float, OPG> scale_j, vector<float, OPG> minv_j,
    vector_ref<half, 8*32> Blo, vector_ref<half, 8*32> Bhi)
{
    vector<uint, 4*OPG> q = cm_ptr_load<uint, 4*OPG>((uint*)pqs_base, pe_byte + j*256);

    vector<float, 4*OPG> scale4, minv4;
    vector<uint,  4*OPG> Hs;
    #pragma unroll
    for (int c = 0; c < 4; c++) {
        scale4.select<OPG,1>(c*OPG) = scale_j;
        minv4 .select<OPG,1>(c*OPG) = minv_j;
        /* 5th-bit shift is (base + c); pre-applying the >>c part here means
         * each extraction below only needs a shift by a scalar immediate,
         * and neither the replicated H nor a per-element c vector has to
         * stay live (that extra live state made this spill). */
        Hs    .select<OPG,1>(c*OPG) = H >> (uint)c;
    }

    matrix_ref<half, 8, 32> Bl = Blo.format<half, 8, 32>();
    matrix_ref<half, 8, 32> Bh = Bhi.format<half, 8, 32>();

    /* lo k3=0..3 use 5th-bit shifts c, 8+c, 16+c, 24+c; hi adds 4. */
    { vector<float,4*OPG> r=(q & 0xFu)|((Hs&1u)<<4);          r=r*scale4-minv4; Bl.select<4,2,16,2>(0,0)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>8) &0xFu)|(((Hs>>8 )&1u)<<4); r=r*scale4-minv4; Bl.select<4,2,16,2>(0,1)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>16)&0xFu)|(((Hs>>16)&1u)<<4); r=r*scale4-minv4; Bl.select<4,2,16,2>(1,0)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>24)&0xFu)|(((Hs>>24)&1u)<<4); r=r*scale4-minv4; Bl.select<4,2,16,2>(1,1)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>4) &0xFu)|(((Hs>>4 )&1u)<<4); r=r*scale4-minv4; Bh.select<4,2,16,2>(0,0)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>12)&0xFu)|(((Hs>>12)&1u)<<4); r=r*scale4-minv4; Bh.select<4,2,16,2>(0,1)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>20)&0xFu)|(((Hs>>20)&1u)<<4); r=r*scale4-minv4; Bh.select<4,2,16,2>(1,0)=r.format<float,4,OPG>(); }
    { vector<float,4*OPG> r=((q>>28)&0xFu)|(((Hs>>28)&1u)<<4); r=r*scale4-minv4; Bh.select<4,2,16,2>(1,1)=r.format<float,4,OPG>(); }
}

extern "C" _GENX_MAIN_ void gemm_q5k_full(
    half*  inputs  [[type("svmptr_t")]],
    uchar* weights [[type("svmptr_t")]],   /* pqs_T || pqh_T || psl_T */
    float* outputs [[type("svmptr_t")]],
    uint token_len, uint input_len, uint output_len)
{
    const uint nbpr       = input_len / 256;
    const uint num_blocks = input_len * output_len / 256;

    cm_slm_init(MAX_NBPR * TOKENS_PER_TILE * OPG * sizeof(float));
    uint slm = cm_slm_alloc(MAX_NBPR * TOKENS_PER_TILE * OPG * sizeof(float));

    const uint h  = cm_group_id(0);
    const uint hh = cm_local_id(0);
    const uint t  = cm_group_id(1);

    const uint tile_base = t * TOKENS_PER_TILE;
    const uint tile_len  = (tile_base + TOKENS_PER_TILE <= token_len)
                          ? TOKENS_PER_TILE : (token_len - tile_base);

    uchar* pqs_base = weights;
    uchar* pqh_base = weights + num_blocks * 128u;
    uchar* psl_base = weights + num_blocks * 160u;

    const uint blk      = h * nbpr + hh;
    const uint pe_byte  = blk * (OPG * 128u);
    const uint pqh_byte = blk * (OPG * 32u);
    const uint psl_byte = blk * (OPG * 16u);

    vector<uint, OPG>   sl    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 0);
    vector<uint, OPG>   ml    = cm_ptr_load<uint, OPG>((uint*)psl_base, psl_byte + 64);
    vector<uint, OPG/2> sh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 128);
    vector<uint, OPG/2> mh_u  = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 160);
    vector<uint, OPG/2> d_u   = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 192);
    vector<uint, OPG/2> dmn_u = cm_ptr_load<uint, OPG/2>((uint*)psl_base, psl_byte + 224);
    vector<ushort, OPG> sh16=sh_u.format<ushort>(), mh16=mh_u.format<ushort>();
    vector<half,   OPG> dh=d_u.format<half>(), dminh=dmn_u.format<half>();
    vector<uint,   OPG> shu=sh16, mhu=mh16;
    vector<float,  OPG> dF, dminF; dF=dh; dminF=dminh;

    vector<half, TOKENS_PER_TILE * 256> Atile = (half)0.0f;
    #pragma unroll
    for (uint tt = 0; tt < TOKENS_PER_TILE; tt++) {
        if (tile_base + tt < token_len) {
            uint ib = ((tile_base + tt) * input_len + hh * 256u) * (uint)sizeof(half);
            vector<uint, 64> u0 = cm_ptr_load<uint, 64>((uint*)inputs, ib);
            vector<uint, 64> u1 = cm_ptr_load<uint, 64>((uint*)inputs, ib + 64u * (uint)sizeof(uint));
            Atile.select<128, 1>(tt * 256)       = u0.format<half>();
            Atile.select<128, 1>(tt * 256 + 128) = u1.format<half>();
        }
    }

    vector<float, TOKENS_PER_TILE * OPG> acc = 0.0f;
    #pragma unroll
    for (int j = 0; j < 8; j++) {
        vector<uint, OPG> sq=((sl>>(j*4))&0xFu)|(((shu>>(j*2))&0x3u)<<4);
        vector<uint, OPG> mq=((ml>>(j*4))&0xFu)|(((mhu>>(j*2))&0x3u)<<4);
        vector<float, OPG> sqf, mqf; sqf=sq; mqf=mq;
        vector<float, OPG> scale_j=sqf*dF, minv_j=mqf*dminF;

        vector<uint, OPG> H = cm_ptr_load<uint, OPG>((uint*)pqh_base, pqh_byte + j * 64);
        vector<half, 8*32> Blo=(half)0.0f, Bhi=(half)0.0f;
        q5k_vnni_block_sg(pqs_base, pe_byte, j, H, scale_j, minv_j, Blo, Bhi);

        vector<half, TOKENS_PER_TILE * 16> Alo, Ahi;
        #pragma unroll
        for (uint tt = 0; tt < TOKENS_PER_TILE; tt++) {
            Alo.select<16,1>(tt*16) = Atile.select<16,1>(tt*256 + j*32 + 0);
            Ahi.select<16,1>(tt*16) = Atile.select<16,1>(tt*256 + j*32 + 16);
        }
        acc = cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(acc, Blo.format<int32_t>(), Alo.format<int32_t>());
        acc = cm_dpas<CM_PRECISION_HF,CM_PRECISION_HF,8,TOKENS_PER_TILE>(acc, Bhi.format<int32_t>(), Ahi.format<int32_t>());
    }

    cm_slm_block_write(slm, hh * TOKENS_PER_TILE * OPG * sizeof(float), acc.format<float>());
    cm_fence(CM_LOCAL_BARRIER);
    cm_barrier();

    if (hh == 0) {
        vector<float, TOKENS_PER_TILE * OPG> total = 0.0f;
        for (uint k = 0; k < nbpr; k++) {
            vector<float, TOKENS_PER_TILE * OPG> part;
            cm_slm_block_read(slm, GENX_NONE, k * TOKENS_PER_TILE * OPG * sizeof(float), part.format<float>());
            total += part;
        }
        #pragma unroll
        for (uint tt = 0; tt < TOKENS_PER_TILE; tt++) {
            if (tile_base + tt < token_len) {
                cm_ptr_store<float, OPG>((float*)outputs,
                    ((tile_base + tt) * output_len + h * OPG) * (uint)sizeof(float),
                    total.select<OPG, 1>(tt * OPG));
            }
        }
    }
}
